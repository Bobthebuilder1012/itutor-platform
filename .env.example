# ============================================
# iTutor Platform - Environment Variables Example
# ============================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# DATABASE_URL=

# ============================================
# EMAIL SERVICE (REQUIRED FOR ONBOARDING EMAILS)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=iTutor <hello@myitutor.com>

# ============================================
# CRON JOB SECURITY (REQUIRED FOR PRODUCTION)
# ============================================
CRON_SECRET=your-random-secret-string-here

# ============================================
# FEATURE FLAGS (optional)
# ============================================
# NEXT_PUBLIC_GROUPS_ENABLED=true

# ============================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# ============================================
# NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_SITE_URL=https://itutor.yourdomain.com

NEXT_PUBLIC_MARKETING_ADMIN_EMAIL=marketing.itutor@myitutor.com

# =====================================================
# Teacher verification v2 (all optional; see docs/VERIFICATION_V2_LOCAL_TESTING.md)
# =====================================================
# VERIFICATION_V2_ENABLED=false          # feature flag; default OFF
# VERIFICATION_DEV_TOOLS=false           # /dev/verification-states, non-production builds only
# VERIFICATION_PROCESS_SECRET=           # optional server-to-server secret for the OCR endpoint
# Identity providers: Didit is tried first, then Stripe, then Veriff (IDENTITY_PRIMARY_PROVIDER). A provider
# with no credentials is skipped. TEST / SANDBOX credentials only for local work.
# STRIPE_IDENTITY_WEBHOOK_SECRET=        # whsec_... of the /api/webhooks/stripe-identity endpoint
# IDENTITY_PRIMARY_PROVIDER=             # didit (default) | stripe | veriff: which provider is tried first; the others are the backups
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=
# DIDIT_EXPECT_ENVIRONMENT=sandbox       # ignore webhooks from any other environment
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=
# Local-only scripts (scripts/seed-verification-test-users.mjs, apply-migrations-local.mjs):
# DATABASE_URL=                          # your OWN empty Supabase project, never staging or production
# SEED_ALLOWED_PROJECT_REF=              # that project's ref; the scripts refuse every other remote
